{
	// Renovate keeps the Python dependencies, action pins and pre-commit hooks
	// (run by prek) here current, in place of Dependabot's version updates,
	// and raises the security fixes too; Dependabot's own security pull
	// requests are switched off in the repository settings, and its ALERTS
	// stay on.
	//
	// Almost everything comes from the shared presets, xiphux/renovate-config:
	// default.json5 holds the cooldowns, the auto-merge policy, the weekly
	// timetable and its groups, lockfile maintenance and the vulnerability
	// alerts; python.json5 holds `rangeStrategy: update-lockfile` for pep621
	// and ruff's 0.x minors. Each has its rationale beside it. What follows is
	// only what differs here. This file's packageRules are appended after the
	// presets', and later rules win.
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',

	extends: [
		'github>xiphux/renovate-config:default.json5',
		'github>xiphux/renovate-config:python.json5',
	],

	// The pre-commit manager is DISABLED by default and has to be opted into --
	// it is still beta upstream. Without this, dropping dependabot.yml would
	// silently stop .pre-commit-config.yaml's `rev:` pins from ever moving
	// again. One repo is pinned there today (pre-commit-hooks); ruff and
	// gitleaks are local hooks with nothing to pin. The hooks run under prek,
	// not pre-commit, but this manager parses the YAML file itself, whatever
	// runs it; it does not read prek.toml, so the config stays YAML.
	'pre-commit': {
		enabled: true,
	},

	// Deliberately small. Actions minutes are free on a public repository, so
	// unlike the private repos this is not a billing decision: it bounds how
	// many open PRs a single merge invalidates, since `rebaseWhen:
	// 'behind-base-branch'` rebases every one left behind and each rebase
	// re-runs CI. Kept in line with the private repositories, where the same
	// number is a direct saving, so the configs stay comparable. Not a
	// throughput cap: prHourlyLimit (2, the default) limits creation well below
	// it. Majors are what to watch, since one nobody merges holds its slot
	// indefinitely.
	prConcurrentLimit: 5,

	// `deps:` / `deps(dev):` for Python and `ci:` for actions and hooks, as
	// Dependabot wrote them.
	commitMessagePrefix: 'deps:',

	packageRules: [
		{
			matchManagers: ['pep621'],
			matchDepTypes: ['dependency-groups', 'tool.uv.dev-dependencies'],
			commitMessagePrefix: 'deps(dev):',
		},
		{
			// The preset gives actions this prefix and cooldown; hooks get them
			// here. A hijacked action tag or hook release is usually caught and
			// pulled within days; a week keeps a fresh compromise from reaching a
			// pin automatically.
			matchManagers: ['github-actions', 'pre-commit'],
			commitMessagePrefix: 'ci:',
			minimumReleaseAge: '7 days',
		},
		{
			// The 0.x packages whose minors CI can actually judge, carried over
			// from ZERO_X_MINOR_OK: each is exercised by the test suite rather
			// than merely installed by it. (python.json5 already trusts ruff's.)
			// The pattern leaves out prereleases: this rule lands after the
			// preset's "never auto-merge prereleases" rule, and `/^v?0\./` would
			// re-enable one.
			matchPackageNames: ['fastapi', 'uvicorn', 'aiosqlite', 'respx', 'ruff'],
			matchUpdateTypes: ['minor'],
			matchCurrentVersion: '/^v?0\\.[^-]*$/',
			automerge: true,
		},
		{
			// The ZERO_X_MINOR_OK packages above, back in their group. The
			// timetable leaves 0.x packages out only because their minors do not
			// auto-merge, and these do -- without this, most of this
			// repository's runtime dependencies would each raise a pull request
			// of their own on Sunday. (python.json5 does the same for ruff.)
			groupName: 'production dependencies',
			matchPackageNames: ['fastapi', 'uvicorn', 'aiosqlite'],
			matchUpdateTypes: ['minor', 'patch'],
			schedule: ['* 0-5 * * 5'],
		},
		{
			// The test mocking stack moves together, so CI never sees half a
			// family bumped: pytest-httpx2 registers respx's httpcore2 mocker,
			// and respx still builds its mocks from httpx v1 types (see the
			// DEFAULT_MOCKER note in tests/conftest.py). A group of its own
			// rather than part of test and build: httpx is 0.x and its minors do
			// not auto-merge, so it holds this group open, and only this one.
			// After the presets' groups, so it takes pytest-httpx2 out of test
			// and build; in that group's slot.
			groupName: 'respx',
			matchUpdateTypes: ['minor', 'patch'],
			matchPackageNames: ['respx', 'httpx', 'pytest-httpx2'],
			schedule: ['* 0-5 * * 4'],
		},
		{
			// The Dockerfile's base image, which Dependabot was never configured
			// to watch here -- Renovate's dockerfile manager is on by default,
			// so this is new coverage rather than a port. Both stages pin
			// python's alpine image; a patch or minor of that tag merges on a
			// green CI run like anything else, and the image smoke job in ci.yml
			// is what judges it. A major is held, as majors are everywhere here.
			// Ungrouped, so it waits for Sunday's slot.
			matchManagers: ['dockerfile'],
			commitMessagePrefix: 'ci:',
		},
	],
}
